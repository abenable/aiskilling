{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aiskilling",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Wraps the TanStack Start handler: www -> apex redirect + security headers.
	"main": "src/server.ts",
	"routes": [
		{ "pattern": "aiskilling.dev", "custom_domain": true },
		{ "pattern": "www.aiskilling.dev", "custom_domain": true }
	],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aiskilling-db",
			"database_id": "cb0f4869-91cd-47f2-9869-0933e6c57370",
			"migrations_dir": "migrations"
		}
	],
	// Join form: 5 submissions per IP per minute.
	"ratelimits": [
		{ "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
	]
}
